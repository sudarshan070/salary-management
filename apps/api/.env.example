# Port the API listens on (Render sets this automatically).
PORT=3000
# Allowed browser origin for CORS. Use the Vercel URL in production.
CORS_ORIGIN=http://localhost:5173
# Shown by /health.
APP_VERSION=0.1.0
# SQLite database. Local file by default; a libsql:// Turso URL in production.
DATABASE_URL=file:local.db
# Turso token (production only). Never commit a real value.
DATABASE_AUTH_TOKEN=
# Seed 10,000 demo employees on startup if the table is empty.
SEED_IF_EMPTY=true
